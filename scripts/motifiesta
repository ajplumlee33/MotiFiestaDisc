#!/usr/bin/env python

import sys
import argparse

import warnings
warnings.simplefilter("ignore", UserWarning)

from MotiFiesta.training.model import MotiFiestaModel
from MotiFiesta.training.loading import get_loader
from MotiFiesta.training.train import motif_train
from MotiFiesta.utils.learning_utils import dump_model_hparams
from MotiFiesta.utils.learning_utils import load_model
from MotiFiesta.utils.learning_utils import make_dirs
from MotiFiesta.utils.learning_utils import get_device


FUNCTIONS = ['train', 'test', 'build', 'browse', 'eval']

try:
    function = sys.argv[1]
except IndexError:
    raise ValueError("Specify a valid function please")


print(f"== {function} mode ==")

if function == 'train':
    parser = argparse.ArgumentParser()
    parser.add_argument("--name", "-n", type=str, default="default")
    parser.add_argument("--mode", type=str, default="default", choices=["default", "disc"])
    parser.add_argument("--dataset", "-da", type=str, default='synthetic')
    parser.add_argument("--data_root", type=str, default='.')
    parser.add_argument("--restart", "-r", action='store_true', default=False)

    # training loop
    parser.add_argument("--batch-size", "-b", type=int, default=16)
    parser.add_argument("--max-batches", "-m", type=int, default=-1)
    parser.add_argument("--epochs", "-e", type=int, default=25)
    parser.add_argument("--stop-epochs", type=int, default=30)
    parser.add_argument("--attributed", default=False, action='store_true')

    # learning
    parser.add_argument("--lam",  type=float, default=1)
    parser.add_argument("--beta", type=float, default=1)
    parser.add_argument("--estimator", "-es", type=str, default='knn')
    parser.add_argument("--n-neighbors", "-nn", type=int, default=30)
    parser.add_argument("--volume", "-vv", action='store_true', default=False)

    # default-mode architecture
    parser.add_argument("--steps", "-s", type=int, default=5)
    parser.add_argument("--dim", "-d", type=int, default=8)
    parser.add_argument("--pool-dummy", action="store_true", default=False)
    parser.add_argument("--score-method", default="sigmoid")
    parser.add_argument("--merge-method", default="sum")
    parser.add_argument("--hard-embed", action='store_true')

    # disc-mode args
    parser.add_argument("--hidden-dim", type=int, default=32,
                        help="gin hidden dimension (disc mode).")
    parser.add_argument("--gin-layers", type=int, default=2,
                        help="gin depth per induced subgraph (disc mode).")
    parser.add_argument("--k", type=int, default=30,
                        help="knn neighbors for freq_loss (disc mode).")
    parser.add_argument("--walk-lens", type=str, default="1,2,3",
                        help="comma-separated ego-net hop radii, one per level (disc mode).")
    parser.add_argument("--wl-hops", type=int, default=1,
                        help="wl neighbor-sum hops for full-graph feature augmentation (disc mode).")
    parser.add_argument("--warmup", type=int, default=0,
                        help="epochs of rec_loss warmup before switching to freq_loss (disc mode).")
    parser.add_argument("--freq-lr", type=float, default=1e-3,
                        help="initial lr for freq_loss phase after warmup (disc mode).")
    parser.add_argument("--sigma", type=float, default=0.5,
                        help="gaussian kde bandwidth for freq_loss (disc mode).")
    parser.add_argument("--pool", type=str, default="mean", choices=["mean", "anchor", "attn"],
                        help="subgraph pooling: mean, anchor-only, or attention-weighted (disc mode).")
    parser.add_argument("--tau", type=float, default=0.1)
    parser.add_argument("--lr-patience", type=int, default=0,
                        help="ReduceLROnPlateau patience for freq phase (0 = disabled).")

    args, _ = parser.parse_known_args()
    print(args)

    make_dirs(args.name)

    print(">>> loading data")
    data = get_loader(
        name=args.dataset,
        root=args.data_root,
        batch_size=args.batch_size,
        attributed=args.attributed if hasattr(args, 'attributed') else False,
    )
    n_features = data['dataset_whole'].num_features
    print(n_features)

    print(">>> building model")

    if args.mode == 'disc':
        from MotiFiesta.disc.disc_model import MotiFiestaDisc
        from MotiFiesta.disc.disc_train import disc_train
        import torch
        walk_lens = [int(x) for x in args.walk_lens.split(',')]
        disc_hparams = {
            'model_type': 'disc',
            'hidden_dim': args.hidden_dim,
            'gin_layers': args.gin_layers,
            'walk_lens':  walk_lens,
            'wl_hops':    args.wl_hops,
            'n_features': n_features,
            'pool':       args.pool,
        }
        hparams = {'model': disc_hparams, 'train': {
            'epochs':     args.epochs,
            'batch_size': args.batch_size,
            'k':          args.k,
            'lam':        args.lam,
            'beta':       args.beta,
        }}
        dump_model_hparams(args.name, hparams)
        if args.restart:
            print(f"restarting training with id: {args.name}")
            ckpt = torch.load(f'models/{args.name}/{args.name}.pth', map_location='cpu',
                              weights_only=False)
            model = MotiFiestaDisc(**disc_hparams)
            model.load_state_dict(ckpt['model_state_dict'])
            epoch_start = ckpt['epoch'] + 1
            best_loss = ckpt.get('best_loss', float('inf'))
            # if restarting past the warmup boundary, use freq_lr for a fresh optimizer
            # rather than loading saved momentum which may cause bouncing
            if epoch_start > args.warmup and args.freq_lr != 1e-3:
                optimizer = torch.optim.Adam(model.parameters(), lr=args.freq_lr)
            else:
                optimizer = torch.optim.Adam(model.parameters())
                optimizer.load_state_dict(ckpt['optimizer_state_dict'])
        else:
            model = MotiFiestaDisc(**disc_hparams)
            epoch_start, optimizer, best_loss = 0, None, float('inf')
        print(model)
        print(">>> training...")
        disc_train(
            model,
            train_loader=data['loader_train'],
            test_loader=data['loader_test'],
            model_name=args.name,
            epochs=args.epochs,
            max_batches=args.max_batches,
            n_neighbors=args.k,
            beta=args.beta,
            lam=args.lam,
            epoch_start=epoch_start,
            best_loss=best_loss,
            optimizer=optimizer,
            warmup=args.warmup,
            freq_lr=args.freq_lr,
            sigma=args.sigma,
            tau=args.tau,
            lr_patience=args.lr_patience,
        )
    else:
        hparams = {'model': {
            'dim': args.dim, 'steps': args.steps, 'pool_dummy': args.pool_dummy,
            'edge_score_method': args.score_method, 'merge_method': args.merge_method,
            'hard_embed': args.hard_embed, 'gin_layers': args.gin_layers,
            'n_features': n_features,
        }, 'train': {
            'epochs': args.epochs, 'batch_size': args.batch_size,
            'max_batches': args.max_batches, 'dataset': args.dataset,
            'lambda': args.lam, 'beta': args.beta, 'stop_epochs': args.stop_epochs,
            'estimator': args.estimator, 'k': args.n_neighbors,
            'volume': args.volume, 'attributed': args.attributed,
        }}
        dump_model_hparams(args.name, hparams)
        if args.restart:
            print(f"restarting training with id: {args.name}")
            model_dict = load_model(args.name)
            model = model_dict['model']
            epoch_start = model_dict['epoch']
            optimizer = model_dict['optimizer']
            controller_state = model_dict['controller_state_dict']
        else:
            model = MotiFiestaModel(**hparams['model'])
            epoch_start, optimizer, controller_state = 0, None, None
        print(model)
        print(">>> training...")
        motif_train(model,
                    train_loader=data['loader_train'],
                    test_loader=data['loader_test'],
                    model_name=args.name,
                    epochs=args.epochs,
                    max_batches=args.max_batches,
                    stop_epochs=args.stop_epochs,
                    estimator=args.estimator,
                    volume=args.volume,
                    n_neighbors=args.n_neighbors,
                    hard_embed=args.hard_embed,
                    beta=args.beta,
                    lam=args.lam,
                    epoch_start=epoch_start,
                    optimizer=optimizer,
                    controller_state=controller_state)

import sys; sys.exit(0)
