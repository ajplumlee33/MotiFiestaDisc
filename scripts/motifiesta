#!/urs/bin/env/ python

import sys
import pickle
import argparse

import numpy as np
import warnings
warnings.simplefilter("ignore", UserWarning)

from MotiFiesta.training.model import MotiFiestaModel
from MotiFiesta.training.loading import get_loader
from MotiFiesta.training.train import motif_train
from MotiFiesta.training.sys_train import sys_train
from MotiFiesta.utils.learning_utils import dump_model_hparams
from MotiFiesta.utils.learning_utils import load_model
from MotiFiesta.utils.learning_utils import load_data
from MotiFiesta.utils.learning_utils import make_dirs


FUNCTIONS = ['train', 'test', 'build', 'browse', 'eval']

try:
    function = sys.argv[1]
except IndexError:
    raise ValueError("Specify a valid function please")


print(f"== {function} mode ==")

if function == 'train':
    parser = argparse.ArgumentParser()
    parser.add_argument("--name", "-n", type=str, default="default")
    parser.add_argument("--dataset", "-da", type=str, default='synthetic')
    parser.add_argument("--data_root", type=str, default='.')
    parser.add_argument("--restart", "-r", action='store_true', default=False,  help='Restart model.')
    parser.add_argument("--disc", "-di", action='store_true', default=False,  help='Discovery mode.')
    parser.add_argument("--mode", "-md", default='combined',
                        choices=['mot', 'sil', 'combined'],
                        help='Loss mode. mot = density loss only, sil = sampling invariance loss only, combined = both.')

    parser.add_argument("--batch-size", "-b", type=int, default=16)
    parser.add_argument("--max-batches", "-m", type=int, default=-1)
    parser.add_argument("--epochs", "-e", type=int, default=200)
    parser.add_argument("--stop-epochs", type=int, default=30, help="Number of epochs to train embeddings before doing motifs.")
    parser.add_argument("--attributed", default=False, action='store_true', help="Use attributed graphs. If False, use node degree as features.")


    parser.add_argument("--lam",  type=float, default=1)
    parser.add_argument("--beta", type=float, default=1)
    parser.add_argument("--estimator", "-es", type=str, default='knn', help="Which density estimator to use for the motif agg. step")
    parser.add_argument("--n-neighbors", "-nn", type=int, default=30, help="Number of neighbors")
    parser.add_argument("--volume", "-vv", action='store_true', default=False, help="Use d-sphere volume to normalize density with kNN.")
    parser.add_argument('--rec-kernel', choices=['wwl', 'wl'], default='wl')
    parser.add_argument('--edge-sample-rate', type=float, default=1.0)
    parser.add_argument("--sil-momentum", type=float, default=0.95,
                        help="EMA momentum for the sampling invariance tracker (higher = more stable targets)")

    parser.add_argument("--steps", "-s", type=int, default=5)
    parser.add_argument("--dim", "-d", type=int, default=8)
    parser.add_argument("--pool-dummy", action="store_true", default=False)
    parser.add_argument("--score-method", default="sigmoid", help="Edge scoring method: (sigmoid, softmax-neighbors, softmax-all)")
    parser.add_argument("--merge-method", default="sum", help="Edge merge method: (sum, cat, set2set)")
    parser.add_argument("--hard-embed", action='store_true', help="Whether to use hard embedding using degree histogram.")
    parser.add_argument("--parallel-matching", action='store_true', default=False, help="Use Luby parallel matching in EdgePooling layers.")

    # --- Synthetic single-graph dataset flags (used only when data_root --
    # contains 'sys_synth'; silently ignored otherwise) -----------------------
    parser.add_argument("--motif-type", type=str, default='clique',
                        choices=['star', 'barbell', 'wheel', 'random',
                                 'clique', 'lollipop'],
                        help="Motif type to plant. Same names as "
                             "synthetic.generate_instances.")
    parser.add_argument("--motif-size", type=int, default=5,
                        help="Motif size knob, interpreted by motif_menu "
                             "(matches generate_instances semantics).")
    parser.add_argument("--n-motifs", type=int, default=10,
                        help="Number of motif instances to plant.")
    parser.add_argument("--parent-size", type=int, default=1000,
                        help="Parent graph size for SysSyntheticDataset.")
    parser.add_argument("--parent-e-prob", type=float, default=0.005,
                        help="Erdős-Rényi edge probability for the parent graph.")
    parser.add_argument("--random-e-prob", type=float, default=None,
                        help="Edge probability used when motif_type='random'. "
                             "Defaults to parent-e-prob, but for single-graph "
                             "mode the parent is sparse so random motifs end "
                             "up empty — override to ~0.3-0.5 for visible "
                             "random motifs.")
    parser.add_argument("--distort-p", type=float, default=0.0,
                        help="Per-edge distortion probability applied to each "
                             "planted motif instance. 0.0 = exact topology.")
    parser.add_argument("--dataset-seed", type=int, default=0,
                        help="RNG seed for synthetic dataset generation. "
                             "Separate from training RNG.")

    args, _ = parser.parse_known_args()
    print(args)

    make_dirs(args.name)

    hparams = {'model':{
                        'dim': args.dim,
                        'steps': args.steps,
                        'pool_dummy': args.pool_dummy,
                        'edge_score_method': args.score_method,
                        'merge_method': args.merge_method,
                        'hard_embed': args.hard_embed,
                        'parallel_matching': args.parallel_matching,
                         },
               'train': {
                        'epochs': args.epochs,
                        'batch_size': args.batch_size,
                        'max_batches': args.max_batches,
                        'dataset': args.dataset,
                        'lambda': args.lam,
                        'beta': args.beta,
                        'stop_epochs': args.stop_epochs,
                        'estimator': args.estimator,
                        'k': args.n_neighbors,
                        'volume': args.volume,
                        'attributed': args.attributed,
                        'mode': args.mode,
                        'sil_momentum': args.sil_momentum,
                        }
                }

    # Build synth-dataset kwargs only when the data_root asks for it.
    # get_loader filters these to the keys SysSyntheticDataset accepts,
    # so this is belt-and-suspenders — but keeping the build explicit
    # makes the CLI's intent readable.
    loader_extra = {}
    if 'sys_synth' in args.data_root:
        loader_extra['motif_type'] = args.motif_type
        loader_extra['motif_size'] = args.motif_size
        loader_extra['n_motifs'] = args.n_motifs
        loader_extra['parent_size'] = args.parent_size
        loader_extra['parent_e_prob'] = args.parent_e_prob
        if args.random_e_prob is not None:
            loader_extra['random_e_prob'] = args.random_e_prob
        loader_extra['distort_p'] = args.distort_p
        loader_extra['seed'] = args.dataset_seed
        print(f">>> sys_synth kwargs: {loader_extra}")

    print(">>> loading data")
    data = get_loader(
                      name=args.dataset,
                      root=args.data_root,
                      batch_size=hparams['train']['batch_size'],
                      attributed=hparams['train']['attributed'],
                      **loader_extra,
                      )

    hparams['model']['n_features'] = data['dataset_whole'].num_features
    print(data['dataset_whole'].num_features)
    dump_model_hparams(args.name, hparams)

    print(">>> building model")

    if args.restart:
        print(f"Restarting training with ID: {args.name}")
        model_dict = load_model(args.name)
        model = model_dict['model']
        epoch_start = model_dict['epoch']
        optimizer = model_dict['optimizer']
        controller_state = model_dict['controller_state_dict']
    else:
        model = MotiFiestaModel(**hparams['model'])
        epoch_start, optimizer, controller_state = 0, None, None
    print(model)

    print(">>> training...")
    if not args.disc:
        motif_train(model,
                    train_loader=data['loader_train'],
                    test_loader=data['loader_test'],
                    model_name=args.name,
                    epochs=args.epochs,
                    max_batches=args.max_batches,
                    stop_epochs=args.stop_epochs,
                    estimator=args.estimator,
                    volume=args.volume,
                    n_neighbors=args.n_neighbors,
                    hard_embed=args.hard_embed,
                    beta=args.beta,
                    lam=args.lam,
                    epoch_start=epoch_start,
                    optimizer=optimizer,
                    controller_state=controller_state
                    )
    else:
        sys_train(model,
                    train_loader=data['loader_train'],
                    test_loader=data['loader_test'],
                    source_graph=data['dataset_whole'],
                    mode=args.mode,
                    rec_kernel=args.rec_kernel,
                    edge_sample_rate=args.edge_sample_rate,
                    sil_momentum=args.sil_momentum,
                    model_name=args.name,
                    epochs=args.epochs,
                    max_batches=args.max_batches,
                    stop_epochs=args.stop_epochs,
                    estimator=args.estimator,
                    volume=args.volume,
                    n_neighbors=args.n_neighbors,
                    hard_embed=args.hard_embed,
                    beta=args.beta,
                    lam=args.lam,
                    epoch_start=epoch_start,
                    optimizer=optimizer,
                    controller_state=controller_state,
                    )
